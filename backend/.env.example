# Copy to .env for local dev (never commit the real .env)
PORT=8080
JWT_SECRET=replace-with-a-long-random-string
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# Google AI Studio (free) — enables the Gemini models in the picker.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Persistence: leave unset (or false) for in-memory dev storage,
# or "true" to persist to Cloud Firestore (Native mode).
USE_FIRESTORE=false

# One-off migration of old MongoDB accounts: on first login with an unknown
# email, forward the credentials to this legacy API and import the account
# (with conversations, settings, memory) into Firestore. Set to '' to disable.
LEGACY_API_BASE=https://api.mmi25b11.mmi-troyes.fr
# Firebase Admin credentials.
# Cloud Run can use ADC. On Vercel, set ONE of these:
#   FIREBASE_SERVICE_ACCOUNT_JSON=<entire service-account JSON>
# or the split values below:
#   FIREBASE_PROJECT_ID=nexus-ai-2077
#   FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@nexus-ai-2077.iam.gserviceaccount.com
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Local alternative:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
